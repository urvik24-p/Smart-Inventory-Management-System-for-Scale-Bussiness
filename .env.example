# Copy these names into your hosting provider's secret/environment settings.
SPRING_DATASOURCE_URL=jdbc:mysql://db-host:3306/inventory?useSSL=true&requireSSL=true
SPRING_DATASOURCE_USERNAME=inventory_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-secret
JWT_SECRET=base64-encoded-32-byte-or-longer-random-secret
JWT_EXPIRATION_MS=900000
ALLOWED_ORIGINS=https://inventory.example.com
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
# Set these only for the first successful production start, then remove them.
APP_BOOTSTRAP_ADMIN_USERNAME=initial-admin
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
